# Copy to .env and fill in. Keys come from env only — never committed.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Premade voice "Sarah"; must be a voice in YOUR account's voice list
# (GET /v1/voices) — free API accounts cannot use library voices.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# TTS provider: "elevenlabs" (needs its key + quota) or "aura" (Deepgram
# Aura-2 over the same DEEPGRAM_API_KEY; measured warm ttfb ~350-380 ms).
TTS_PROVIDER=elevenlabs

# Speech request processing tier (opt-in, billed at a premium). Measured: a big
# win on a tiny probe prompt, a wash on the real prompt - see config.py.
OPENAI_SPEECH_SERVICE_TIER=default

# Telephony (optional): Twilio Media Streams. PUBLIC_BASE_URL is your tunnel
# origin (ngrok/cloudflared -> port 8080); Twilio must reach wss://<it>/ws/twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=

# Turn model is a measured choice, benchmarked — override to trial others.
TURN_MODEL=gpt-5.6-luna
